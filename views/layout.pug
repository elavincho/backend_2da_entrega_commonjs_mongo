doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= titulo
    link(rel="stylesheet" href="/css/styles.css")

  body

    if usuario.rol === "usuario"
      header
        nav
          ul
            li: a(href="/dashboard") Dashboard
            li: a(href="/productos") Productos
            li: a(href="/clientes") Clientes
            li: a(href="/proveedores") Proveedores
            li: a(href="/finanzas") Finanzas
            li: a(href="/ordenes-pago") Órdenes de Pago
            li: a(href="/facturas-proveedor") Facturas
            li(style="margin-left: auto;")
              span #{usuario.username}
              a(href="/logout" style="margin-left: 10px; color: #ff6b6b;") Cerrar Sesión

    if usuario.rol === 'admin'
      header
        nav
          ul
            li: a(href="/dashboard") Dashboard
            li: a(href="/admin") Usuarios
            li: a(href="/productos") Productos
            li: a(href="/clientes") Clientes
            li: a(href="/proveedores") Proveedores
            li: a(href="/finanzas") Finanzas
            li: a(href="/ordenes-pago") Órdenes de Pago
            li: a(href="/facturas-proveedor") Facturas
            li(style="margin-left: auto;")
              span #{usuario.username}
              a(href="/logout" style="margin-left: 10px; color: #ff6b6b;") Cerrar Sesión

    main
      block contenido

    footer
      p &copy; 2024 TodoStock S.A. - Todos los derechos reservados