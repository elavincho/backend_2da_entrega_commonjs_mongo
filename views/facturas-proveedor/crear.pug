extends ../layout

block contenido
  h1= titulo

  if error
    .error-msg= error

  .info-message(style="background-color: #e7f3ff; border-left: 4px solid #2196F3; padding: 12px; margin-bottom: 20px; border-radius: 4px;")
    p(style="margin: 0;")
      strong 💡 Información: 
      | Si el producto no existe en el inventario, se creará automáticamente al guardar la factura.

  form(action="/facturas-proveedor/nuevo" method="POST" id="formFactura")
    // Información de la Factura
    fieldset
      legend Datos de la Factura

      div(style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; width: 100%")

        div
          label(for="fechaEmision") Fecha de Emisión:
          input(type="date" name="fechaEmision" id="fechaEmision" required value=datos ? datos.fechaEmision : new Date().toISOString().split('T')[0])

        div
          label(for="proveedorId") Proveedor:
          select(name="proveedorId" id="proveedorId" required)
            option(value="") Seleccione un proveedor
            each proveedor in proveedores
              option(value=proveedor.id selected=(datos && datos.proveedorId == proveedor.id))
                | #{proveedor.tipoDoc === 'DNI' ? proveedor.nombre : proveedor.razonSocial} - #{proveedor.nroDoc}

        div
          label(for="puntoVenta") Punto de Venta:
          input(type="number" name="puntoVenta" id="puntoVenta" value=datos ? datos.puntoVenta : '1')

        div
          label(for="numero") Número de Factura:
          input(type="number" name="numero" id="numero" required value=datos ? datos.numero : '')

        div
          label(for="cae") CAE (Código Autorización):
          input(type="text" name="cae" id="cae" value=datos ? datos.cae : '')

        div
          label(for="fechaVtoCAE") Fecha Vto. CAE:
          input(type="date" name="fechaVtoCAE" id="fechaVtoCAE" value=datos ? datos.fechaVtoCAE : '')

        div
          label(for="fechaVencimiento") Fecha de Vencimiento Factura:
          input(type="date" name="fechaVencimiento" id="fechaVencimiento" value=datos ? datos.fechaVencimiento : '')


    // Detalle de productos/servicios

    fieldset
      legend Detalle de la Factura
      table#detalleTable(style="width: 100%; border-collapse: collapse;")
        thead
          tr(style="background-color: #f2f2f2;")
            th(style="padding: 8px; border: 1px solid #ddd;") Producto/Concepto
            th(style="padding: 8px; border: 1px solid #ddd;") Código
            th(style="padding: 8px; border: 1px solid #ddd;") Descripción
            th(style="padding: 8px; border: 1px solid #ddd;") Cantidad
            th(style="padding: 8px; border: 1px solid #ddd;") P. Unitario
            th(style="padding: 8px; border: 1px solid #ddd;") Alic. IVA
            th(style="padding: 8px; border: 1px solid #ddd;") Importe
            th(style="padding: 8px; border: 1px solid #ddd;")
        tbody
          tr
            td
              select(name="detalles[productoId][]" style="width: 100%; padding: 5px;" class="producto-select")
                option(value="") -- Seleccionar producto --
                each producto in productos
                  option(value=producto.id data-nombre=producto.nombre data-precio=producto.precio)
                    | #{producto.id} - #{producto.nombre}
            td: input(type="text" name="detalles[codigo][]" style="width: 100%; padding: 5px;" placeholder="Código")
            td: input(type="text" name="detalles[descripcion][]" required style="width: 100%; padding: 5px;")
            td: input(type="number" step="any" name="detalles[cantidad][]" value="1" class="calcular" style="width: 100%; padding: 5px;")
            td: input(type="number" step="any" name="detalles[precioUnitario][]" value="0" class="calcular" style="width: 100%; padding: 5px;")
            td: select(name="detalles[alicIva][]" style="width: 100%; padding: 5px;")
              option(value="21%") 21%
              option(value="10.5%") 10.5%
              option(value="0%") 0%
            td: input(type="text" name="detalles[importe][]" readonly class="importe" style="width: 100%; padding: 5px; background-color: #f5f5f5;")
            td: button(type="button" onclick="eliminarRenglon(this)" style="padding: 5px 10px; background-color: #dc3545; color: white; border: none; border-radius: 3px; cursor: pointer;") X

      button(type="button" onclick="agregarRenglon()" style="margin-top: 10px; padding: 5px 15px; background-color: #28a745; color: white; border: none; border-radius: 3px; cursor: pointer;") + Agregar Producto

      // Totales
      div(style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; width: 100%")
        div
          label(style="font-weight: bold;") Otros Tributos:
          input(type="number" step="any" name="otrosTributos" id="otrosTributos" value="0" style="width: 100%; margin-left: 10px;")
        div
          label(style="font-weight: bold;") Subtotal Neto:
          input(type="text" id="subtotalNeto" readonly style="width: 100%; margin-left: 10px; background-color: #f5f5f5;")
        div
          label(style="font-weight: bold;") IVA 21%:
          input(type="text" id="iva21" readonly style="width: 100%; margin-left: 10px; background-color: #f5f5f5;")
        div
          label(style="font-weight: bold;") IVA 10.5%:
          input(type="text" id="iva105" readonly style="width: 100%; margin-left: 10px; background-color: #f5f5f5;")
        div(style="font-size: 1.2rem; margin-top: 10px;")
          label(style="font-weight: bold;") TOTAL:
          input(type="text" name="total" id="total" readonly style="width: 100%; margin-left: 10px; font-weight: bold; background-color: #f5f5f5;")


    // Observaciones
    fieldset
      div
        label Observaciones:
        textarea(name="observaciones" rows="3" style="width: 100%;")= datos ? datos.observaciones : '' 

    div.form-actions(style="margin-top: 20px; text-align: center;")
      button(type="submit" style="padding: 10px 30px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;") Generar Factura
      a(href="/facturas-proveedor" style="display: inline-block; margin-left: 10px; padding: 10px 30px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 4px;") Cancelar

  block scripts
    script(src="/js/script.js")